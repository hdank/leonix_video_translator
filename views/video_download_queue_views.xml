<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_video_download_queue_tree" model="ir.ui.view">
        <field name="name">leonix.video.download.queue.tree</field>
        <field name="model">leonix.video.download.queue</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Video Download Queue">
                <field name="create_date"/>
                <field name="video_translator_id"/>
                <field name="video_platform"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_video_download_queue_form" model="ir.ui.view">
        <field name="name">leonix.video.download.queue.form</field>
        <field name="model">leonix.video.download.queue</field>
        <field name="arch" type="xml">
            <form string="Video Download">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="video_translator_id"/>
                            <field name="video_url"/>
                            <field name="video_platform"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="result" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_video_download_queue" model="ir.actions.act_window">
        <field name="name">Video Download Queue</field>
        <field name="res_model">leonix.video.download.queue</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_video_download_queue_tree"/>
    </record>
</odoo>
